<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="$style" type="text/css">
</head>

<body>
<div class="page">
<a name="top"></a>

<div id="menubar">
    <a href="#desc">Description</a>
    #if ($documentation.parameters.size() > 0)<a href="#params">Parameters</a>#end
    #if ($documentation.examples.length() != 0)<a href="#examples">Examples</a>#end
    #if ($documentation.notes.length() != 0)<a href="#notes">Notes</a>#end
</div>

<a name="desc"></a>
<div class="box">
    <div class="boxHeader">
        <span>Description</span>
        <span class="anchor"><a href="#top">Top</a></span>
    </div>
    <div class="prose">
        #if ($documentation.description.length() != 0)
            $documentation.description
        #else
            <span class="empty">No description</span>
        #end
    </div>
</div>

#if ($documentation.parameters.size() > 0)
<a name="params"></a>
<div class="box">
    <div class="boxHeader">
        <span>Parameters</span>
        <span class="anchor"><a href="#top">Top</a></span>
    </div>
    <table class="data">
        <tr><th>Name</th><th>Description</th></tr>
        #foreach ($param in $documentation.parameters.keySet())
        <tr>
            <td class="key">$param</td>
            <td>$documentation.parameters.get($param)</td>
        </tr>
        #end
    </table>
</div>
#end

#if ($documentation.examples.length() != 0)
<a name="examples"></a>
<div class="box">
    <div class="boxHeader">
        <span>Examples</span>
        <span class="anchor"><a href="#top">Top</a></span>
    </div>
    <div class="prose">$documentation.examples</div>
</div>
#end

#if ($documentation.notes.length() != 0)
<a name="notes"></a>
<div class="box">
    <div class="boxHeader">
        <span>Notes</span>
        <span class="anchor"><a href="#top">Top</a></span>
    </div>
    <div class="prose">$documentation.notes</div>
</div>
#end

</div>
</body>
</html>
