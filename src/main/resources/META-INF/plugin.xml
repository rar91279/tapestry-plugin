<idea-plugin>
  <name>Tapestry</name>
  <id>com.github.rar91279.plugin.tapestry</id>
  <vendor url="https://github.com/rar91279">rar91279</vendor>
  <description><![CDATA[
    <p>Code insight for the <a href="https://tapestry.apache.org">Apache Tapestry 5</a> web framework.</p>
    <ul>
      <li><b>Templates</b> — <code>.tml</code> highlighting, formatting and structure view, with completion and
        references for components, pages, mixins and their parameters.</li>
      <li><b>Tapestry Expression Language</b> — injected into template attributes, with completion, resolution,
        Find Usages, rename and an unresolved-reference inspection.</li>
      <li><b>Navigation</b> — class &harr; template, tag &rarr; documentation, and message catalog keys.</li>
      <li><b>Generation</b> — new page / component / mixin actions, and Safe Delete that removes an element's
        class, templates and message catalogs together.</li>
      <li><b>Views</b> — a Tapestry project view pane and a tool window with live documentation
        (modules, IoC services, core library) and a dependency/usage tree.</li>
      <li><b>Gutter markers</b> for event handlers and injected beans, in Java and Kotlin sources.</li>
    </ul>
    <p>A maintained port of the plugin JetBrains retired into
      <a href="https://github.com/JetBrains/intellij-obsolete-plugins/tree/master/tapestry">intellij-obsolete-plugins</a>,
      rewritten in Kotlin for current IntelliJ Platform versions.</p>
    <p><b>Requires IntelliJ IDEA Ultimate</b> — the plugin builds on the bundled Jakarta EE and Properties plugins,
      so IntelliJ IDEA Community Edition is not supported.</p>
    <p><small>Apache, Apache Tapestry, Tapestry and the Apache Tapestry logo are trademarks of
      <a href="https://www.apache.org">The Apache Software Foundation</a>. This is an independent plugin for working
      with Apache Tapestry and is not affiliated with or endorsed by the ASF.</small></p>
  ]]></description>

  <!-- Java PSI (JavaPsiFacade, the Java stub indexes, the JAVA line-marker provider) is used throughout.
       It was previously only reachable transitively through com.intellij.javaee — an implicit guarantee. -->
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.javaee</depends>
  <depends>com.intellij.properties</depends>
  <depends>com.intellij.modules.jcef</depends>
  <depends optional="true" config-file="tapestry-css-support-plugin.xml">com.intellij.css</depends>
  <category>JVM Frameworks</category>

  <!-- JCEF classes (JBCefBrowserBase etc.) live in this public content module; without an explicit
       module dependency they aren't on the plugin classloader in the 2026.2 module system. -->
  <dependencies>
    <module name="intellij.platform.ui.jcef"/>
    <!-- XmlStructureViewBuilderFactory (used as the TML structure-view factory below) lives in this
         public content module; without the dependency it isn't on the plugin classloader in 2026.2. -->
    <module name="intellij.xml.structureView.impl"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <facetType implementation="com.github.rar91279.plugin.tapestry.intellij.facet.TapestryFacetType"/>
    <framework.detector implementation="com.github.rar91279.plugin.tapestry.intellij.facet.TapestryFacetType$TapestryFrameworkDetector"/>
    <frameworkSupport implementation="com.github.rar91279.plugin.tapestry.intellij.facet.TapestryFrameworkSupportProvider"/>

    <fileTemplateGroup implementation="com.github.rar91279.plugin.tapestry.intellij.TapestryFileTemplateGroupFactory"/>

    <colorSettingsPage implementation="com.github.rar91279.plugin.tapestry.intellij.lang.TemplateColorSettingsPage"/>
    <standardResourceProvider implementation="com.github.rar91279.plugin.tapestry.intellij.TapestryResourceProvider"/>

    <fileType name="TML" implementationClass="com.github.rar91279.plugin.tapestry.lang.TmlFileType" fieldName="INSTANCE" language="TML" extensions="tml"/>
    <typedHandler implementation="com.github.rar91279.plugin.tapestry.lang.TmlTypedHandler"/>
    <syntaxHighlighter key="TML" implementationClass="com.github.rar91279.plugin.tapestry.lang.TmlHighlighter"/>
    <lang.parserDefinition language="TML" implementationClass="com.github.rar91279.plugin.tapestry.psi.TmlParserDefinition"/>
    <lang.parserDefinition language="TEL" implementationClass="com.github.rar91279.plugin.tapestry.psi.TelParserDefinition"/>
    <lang.syntaxHighlighter language="TEL" implementationClass="com.github.rar91279.plugin.tapestry.lang.TelHighlighter"/>

    <multiHostInjector implementation="com.github.rar91279.plugin.tapestry.intellij.lang.TelLanguageInjector" />
    <annotator language="TML" implementationClass="com.github.rar91279.plugin.tapestry.intellij.lang.annotator.TemplateTagAnnotator"/>

    <psi.referenceContributor language="XML" implementation="com.github.rar91279.plugin.tapestry.intellij.lang.reference.TapestryReferenceContributor"/>

    <xml.xmlExtension implementation="com.github.rar91279.plugin.tapestry.intellij.lang.descriptor.TapestryXmlExtension"/>
    <metaDataContributor implementation="com.github.rar91279.plugin.tapestry.intellij.lang.descriptor.TapestryMetaDataContributor"/>

    <xml.schemaProvider implementation="com.github.rar91279.plugin.tapestry.intellij.lang.descriptor.TapestrySchemaProvider"/>

    <xml.elementDescriptorProvider implementation="com.github.rar91279.plugin.tapestry.intellij.lang.descriptor.TapestryTagDescriptorProvider"/>

    <html.embeddedContentSupport implementation="com.github.rar91279.plugin.tapestry.psi.TmlEmbeddedContentSupport"/>

    <lang.formatter language="TML" implementationClass="com.intellij.lang.xhtml.XhtmlFormattingModelBuilder"/>

    <completion.contributor language="TML" implementationClass="com.github.rar91279.plugin.tapestry.intellij.lang.completion.TemplateCompletionContributor"/>

    <lang.findUsagesProvider language="TML"
                             implementationClass="com.github.rar91279.plugin.tapestry.intellij.editorActions.TmlFindUsagesProvider"/>
    <lang.findUsagesProvider language="TEL"
                             implementationClass="com.github.rar91279.plugin.tapestry.intellij.editorActions.TmlFindUsagesProvider"/>
    <methodReferencesSearch implementation="com.github.rar91279.plugin.tapestry.intellij.editorActions.TapestryMethodReferenceSearcher"/>
    <referencesSearch implementation="com.github.rar91279.plugin.tapestry.intellij.editorActions.TapestryPropertyReferenceSearcher"/>
    <implicitUsageProvider implementation="com.github.rar91279.plugin.tapestry.intellij.TapestryImplicitUsageProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="com.github.rar91279.plugin.tapestry.intellij.TapestryEventHandlerLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="UAST" implementationClass="com.github.rar91279.plugin.tapestry.intellij.TapestryInjectedBeanLineMarkerProvider"/>

    <lang.commenter language="TML" implementationClass="com.intellij.lang.xml.XmlCommenter"/>
    <lang.foldingBuilder language="TML" implementationClass="com.intellij.lang.xml.XmlFoldingBuilder"/>
    <codeInsight.parameterInfo language="TML" implementationClass="com.intellij.codeInsight.hint.api.impls.XmlParameterInfoHandler"/>
    <lang.psiStructureViewFactory language="TML" implementationClass="com.intellij.lang.xml.XmlStructureViewBuilderFactory"/>

    <facet.toolWindow id="Tapestry"
                      facetIdList="tapestry"
                      anchor="bottom"
                      secondary="false"
                      icon="TapestryIcons.TapestryToolWindow"
                      factoryClass="com.github.rar91279.plugin.tapestry.intellij.toolwindow.TapestryToolWindowFactory"/>

    <projectViewPane implementation="com.github.rar91279.plugin.tapestry.intellij.view.TapestryProjectViewPane"/>

    <localInspection language="TEL" shortName="TelReferencesInspection" bundle="messages.TapestryBundle" key="tel.references.inspection"
                     groupKey="tapestry.inspections.group" enabledByDefault="true" level="WARNING"
                     implementationClass="com.github.rar91279.plugin.tapestry.intellij.inspections.TelReferencesInspection"/>
    <localInspection language="JAVA" shortName="PublicInstrumentedField" bundle="messages.TapestryBundle"
                     key="public.instrumented.field.inspection" groupKey="tapestry.inspections.group"
                     enabledByDefault="true" level="ERROR"
                     implementationClass="com.github.rar91279.plugin.tapestry.intellij.inspections.PublicInstrumentedFieldInspection"/>
    <lang.inspectionSuppressor language="TML"
                               implementationClass="com.github.rar91279.plugin.tapestry.intellij.inspections.TmlInspectionSuppressor"/>
    <moduleService serviceImplementation="com.github.rar91279.plugin.tapestry.intellij.TapestryModuleSupportLoader"/>
    <!-- Registered per project by the activity below rather than through the application-level
         psi.treeChangeListener EP, which fired for every keystroke in every open project. -->
    <postStartupActivity implementation="com.github.rar91279.plugin.tapestry.intellij.TapestryProjectListenerActivity"/>
  </extensions>

  <actions>
    <action class="com.github.rar91279.plugin.tapestry.intellij.actions.navigation.ClassTemplateNavigation"
            id="ClassTemplateNavigation" text="Class &lt;-&gt; Template Navigation"
            description="Navigate from a class to it's corresponding template and vice-versa.">
      <keyboard-shortcut first-keystroke="control shift G" keymap="$default"/>
    </action>

    <action class="com.github.rar91279.plugin.tapestry.intellij.actions.navigation.TagDocumentationNavigation"
            id="TagDocumentationNavigation" text="Tag to Documentation Navigation"
            description="Navigate from a tag to it's corresponding documentation.">
      <keyboard-shortcut first-keystroke="control shift D" keymap="$default"/>
    </action>

    <group id="GoToTapestryTemplate"
           class="com.github.rar91279.plugin.tapestry.intellij.actions.navigation.TemplatesNavigation"
           text="Tapestry Template" description="Go to template." popup="true">
      <add-to-group group-id="EditorPopupMenu.GoTo" anchor="last"/>
    </group>

    <group id="GoToTapestryClass">
      <separator/>
      <action id="GoToClass"
              class="com.github.rar91279.plugin.tapestry.intellij.actions.navigation.ClassTemplateNavigation"
              text="Tapestry Class" description="Go to class.">
        <keyboard-shortcut first-keystroke="control shift G" keymap="$default"/>
      </action>
      <add-to-group group-id="EditorPopupMenu.GoTo" anchor="last"/>
    </group>

    <group id="TapestryGroup" popup="true" text="Tapestry"
           icon="/documentation/tapestry-file-type-logo.svg"
           class="com.intellij.ide.actions.NonTrivialActionGroup">
      <separator/>
      <action id="AddNewPageAction"
              class="com.github.rar91279.plugin.tapestry.intellij.actions.createnew.action.AddNewPageAction"
              text="Page" description="Add a new page."
              icon="AllIcons.Nodes.Parameter"/>
      <action id="AddNewComponentAction"
              class="com.github.rar91279.plugin.tapestry.intellij.actions.createnew.action.AddNewComponentAction"
              text="Component" description="Add a new component."
              icon="AllIcons.Nodes.Class"/>
      <action id="AddNewMixinAction"
              class="com.github.rar91279.plugin.tapestry.intellij.actions.createnew.action.AddNewMixinAction"
              text="Mixin" description="Add a new mixin."
              icon="AllIcons.Nodes.Method"/>
      <add-to-group group-id="NewGroup" relative-to-action="NewAction" anchor="after"/>
    </group>
  </actions>

  <projectListeners>
    <listener class="com.github.rar91279.plugin.tapestry.intellij.TapestryModuleRootListener" topic="com.intellij.openapi.roots.ModuleRootListener"/>
  </projectListeners>

</idea-plugin>
